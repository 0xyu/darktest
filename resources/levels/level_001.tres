[gd_resource type="Resource" script_class="LevelConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/systems/level_config.gd" id="1_config"]
[ext_resource type="Script" path="res://scripts/systems/stage_enemy_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/enemies/TrainingEnemy.tres" id="3_enemy"]

[sub_resource type="Resource" id="StageEnemyEntry_level_001"]
script = ExtResource("2_entry")
enemy_definition = ExtResource("3_enemy")
count = 1
level_offset = 0
spawn_rule = 0

[resource]
script = ExtResource("1_config")
level_id = 1
template_id = &"default"
difficulty_multiplier = 1.0
enemy_entries = Array[ExtResource("2_entry")]([SubResource("StageEnemyEntry_level_001")])
spawn_rules = [&"random"]
